# my-blog Nginx 설정 예시 (Ubuntu 24.04) — deploy/README.md 7단계
#
# 1) blog.example.com·auth.example.com을 내 주소로 바꿔 /etc/nginx/sites-available/my-blog 로 저장
# 2) sudo ln -s /etc/nginx/sites-available/my-blog /etc/nginx/sites-enabled/my-blog
#    sudo rm -f /etc/nginx/sites-enabled/default        # 기본 'Welcome to nginx' 사이트 끄기
# 3) sudo nginx -t && sudo systemctl reload nginx
# 4) sudo certbot --nginx -d blog.example.com -d auth.example.com --redirect
#    → certbot이 443(https) 설정과 80 → 443 이동을 이 파일에 직접 더한다(인증서 자동 갱신 포함).
#
# HSTS(Strict-Transport-Security)는 앱(블로그·회원 서버)이 보내므로 여기서 또 넣지 않는다.

server_tokens off;

# ---------- 블로그 서버 (Python, 127.0.0.1:8000에서만 열림) ----------
server {
    listen 80;
    listen [::]:80;
    server_name blog.example.com;

    # 첨부 파일 30MB가 base64로 약 40MB가 되어 올라옴
    client_max_body_size 45m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # 실제 방문자 IP를 맨 끝에 붙임 → 블로그가 오른쪽부터 읽음(deploy.config.json의 trusted_proxies = 127.0.0.1)
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # https로 들어왔는지 알려 줌 (빠지면 블로그가 500과 안내를 냄)
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ---------- 회원 서버 (PHP-FPM, 문서 루트는 public/만) ----------
server {
    listen 80;
    listen [::]:80;
    server_name auth.example.com;

    root /srv/my-blog/php-auth/public;
    index index.php;

    # 점(.)으로 시작하는 파일·폴더는 열지 않음
    location ~ /\. {
        deny all;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        # 없는 .php는 404, HTTPS·REMOTE_ADDR(실제 방문자 IP)를 PHP에 넘김
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/my-blog.sock;
    }
}
